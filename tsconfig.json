{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "metonym": ["./src/index.ts"]
    }
  },
  "include": ["scripts", "src", "tests", "bench"],
  "exclude": ["bench/tmp"]
}
